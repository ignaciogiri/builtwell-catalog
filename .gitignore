# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
.env

# agent notes, kept local
AGENTS.md
CLAUDE.md

# Keep the example env file tracked for contributors.
!.env.example

.next-verify

# agent skills, installed with `npx skills add`
.agents/
.claude/skills/

# build tooling
.turbo/

# editors
.idea/

# logs and local test output
*.log
/playwright-report/
/test-results/

# packed tarballs
*.tgz
