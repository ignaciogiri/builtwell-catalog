# Neon Postgres connection string — required.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Vercel Blob — optional. Without it, icons render from their original
# source urls. Create a store with:
#   vercel blob create-store <name> --access public --yes
BLOB_READ_WRITE_TOKEN=""

# Google Analytics 4 measurement id. Optional — unset means no analytics.
NEXT_PUBLIC_GA_ID=""
